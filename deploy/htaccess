# Конфигурация Apache для статического экспорта Next.js на обычном хостинге.
# Копируется в out/.htaccess при деплое (см. .github/workflows/deploy-hosting.yml).

# Страница 404 из экспорта.
ErrorDocument 404 /404.html

# Аккуратные адреса: /about → /about/index.html уже делает DirectoryIndex,
# здесь убираем лишний слэш-редирект и не отдаём листинги.
Options -Indexes
DirectoryIndex index.html

# Типы, которых часто нет в системном mime.types.
AddType image/avif .avif
AddType image/webp .webp
AddType video/mp4 .mp4
AddType font/woff2 .woff2
AddType application/manifest+json .webmanifest

# Сжатие текстовых ответов.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml image/svg+xml
</IfModule>

# Кэш: хэшированные бандлы Next и медиа неизменяемы, HTML всегда свежий.
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|avif|webp|mp4|woff2|svg|png|jpg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header set X-Content-Type-Options "nosniff"
</IfModule>

# Принудительный HTTPS, когда сертификат уже выпущен.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
